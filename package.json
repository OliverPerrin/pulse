{
  "name": "pulse-desktop",
  "version": "0.1.6",
  "description": "Local-first AI coding usage, limits, and cost intelligence.",
  "author": "Oliver Perrin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OliverPerrin/pulse.git"
  },
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "desktop": "node desktop/run-electron.cjs",
    "desktop:smoke": "node desktop/run-electron.cjs --smoke-test",
    "desktop:pack": "electron-builder --mac dir --arm64",
    "desktop:dist": "electron-builder --mac dmg --arm64",
    "site:build": "node scripts/build-marketing.mjs",
    "updater:enable": "node scripts/local-updater.mjs enable",
    "updater:check": "node scripts/local-updater.mjs check",
    "updater:status": "node scripts/local-updater.mjs status",
    "updater:disable": "node scripts/local-updater.mjs disable"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.usagepulse.desktop",
    "productName": "Pulse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "app.js",
      "dashboard-insights.js",
      "dashboard-insights.css",
      "index.html",
      "styles.css",
      "server.mjs",
      "claude-*.mjs",
      "LICENSE",
      "desktop/**/*",
      "marketing/**/*",
      "Pulse-icon.icon/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "Pulse-icon.icon",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "artifactName": "Pulse-${version}-${arch}.${ext}"
  }
}
